# Address of Limenia, without /v1
LIMENIA_BASE_URL=https://app.limenia.eu
# API key of your app (Limenia dashboard, app settings). Server-side only, never in the app.
LIMENIA_API_KEY=lm_live_replace_me
# Webhook secret (shown once when you create the webhook)
LIMENIA_WEBHOOK_SECRET=whsec_replace_me
# Optional, only while you rotate the secret: the previous one
LIMENIA_WEBHOOK_SECRET_PREVIOUS=

PORT=3000
