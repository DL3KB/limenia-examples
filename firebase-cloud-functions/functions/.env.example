# Copy to functions/.env. Non-secret parameters only; Firebase loads this file on deploy.
LIMENIA_BASE_URL=https://app.limenia.eu
# true: disable the Firebase Auth user on ban_user and suspend_user, enable it again on restore.
LIMENIA_DISABLE_FIREBASE_USERS=false

# Secrets are NOT set here but in Cloud Secret Manager:
#   firebase functions:secrets:set LIMENIA_API_KEY
#   firebase functions:secrets:set LIMENIA_WEBHOOK_SECRET
#   firebase functions:secrets:set DEVICE_CHECK_SECRET    (any random string, e.g. openssl rand -hex 32)
# For the emulator, put them in functions/.secret.local (never commit it):
#   LIMENIA_API_KEY=lm_live_replace_me
#   LIMENIA_WEBHOOK_SECRET=whsec_replace_me
#   DEVICE_CHECK_SECRET=replace_me
