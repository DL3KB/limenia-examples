# Add these lines to the .env of your Laravel app.

# Address of Limenia, without /v1
LIMENIA_BASE_URL=https://app.limenia.eu
# API key of your app (Limenia dashboard, app details). Keep it on the server.
LIMENIA_API_KEY=lm_live_replace_me
# Secret of the webhook of your app
LIMENIA_WEBHOOK_SECRET=whsec_replace_me
# Only during a rotation: the previous secret, remove it afterwards
LIMENIA_WEBHOOK_SECRET_PREVIOUS=
