# Copy to .env and load it as secrets of your functions:
#   supabase secrets set --env-file .env            (hosted)
#   supabase functions serve --env-file .env        (local)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase; do not set them here.
LIMENIA_BASE_URL=https://app.limenia.eu
LIMENIA_API_KEY=lm_live_replace_me
LIMENIA_WEBHOOK_SECRET=whsec_replace_me
# Optional, only while you rotate the webhook secret
LIMENIA_WEBHOOK_SECRET_PREVIOUS=
# Signs device check tickets; any random string (openssl rand -hex 32)
DEVICE_CHECK_SECRET=replace_me
# true: ban the Supabase Auth user on ban_user and suspend_user, lift it on restore
LIMENIA_BAN_SUPABASE_USERS=false
